# Telegram Bot Token - 从 @BotFather 获取
BOT_TOKEN=your_bot_token_here

# 超级管理员 Telegram 数字 ID（机器人主人），多个用英文逗号分隔
# 只有这个 ID 的主人才能使用 /setadmin /deladmin 授权他人
# 获取你的 ID：@userinfobot 或 /start 查看
SUPER_ADMINS=123456789,987654321

# 私有模式：true=开启（默认），false=关闭
# 开启时，只有主人和主人授权的人可以管理，即使对方是 Telegram 群管理员也不行
PRIVATE_MODE=true

# 数据库路径
DATABASE_PATH=data/bot.sqlite3

# 日志群或频道 ID，可为空。建议创建一个私密日志群，把机器人拉进去并设为管理员。
# 获取群组 ID：在群中转发任意消息到 @userinfobot
LOG_CHAT_ID=

# 客服中转管理员 ID，多个用英文逗号分隔；为空则使用 SUPER_ADMINS
SUPPORT_ADMINS=

# 默认规则
DEFAULT_WARN_LIMIT=3
DEFAULT_MUTE_SECONDS=3600
DEFAULT_SLOW_SECONDS=5
DEFAULT_SILENT_MESSAGES=3

# 记账默认值
DEFAULT_EXCHANGE_RATE=7.2
DEFAULT_FEE_RATE=0.05

# Web 管理后台端口
WEB_PORT=8080
